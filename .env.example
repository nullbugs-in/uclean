# ---------------------------------------------------------------------------
# UClean environment variables
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# `supabase start` prints the local API URL and anon/service keys on first run;
# paste those into the NEXT_PUBLIC_SUPABASE_* values below.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this to the browser, never prefix it with
# NEXT_PUBLIC_. Used for webhook handling and notification queue writes that
# must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ------------------------------------------------------------
# Browser key: HTTP-referrer restricted to your deployed domains. Used by the
# Places Autocomplete and map picker on the client.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: IP-restricted. Used only by the 6 km driving distance check.
# The distance check MUST run server side; this key must never reach a client.
GOOGLE_MAPS_SERVER_API_KEY=

# --- WhatsApp Business Cloud API (Phase 1 notifications) -------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Used to verify the X-Hub-Signature-256 header on delivery status webhooks.
WHATSAPP_APP_SECRET=

# --- SMS OTP provider -------------------------------------------------------
# Supabase phone auth needs this. India requires DLT registration.
SUPABASE_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Development-only OTP bypass. With no SMS provider configured, real codes
# never arrive locally. When NODE_ENV is not "production", this fixed code is
# accepted at /api/auth/verify-otp and a real Supabase session is minted for it.
# Defaults to 000000 when unset. Set to "off" to disable, or leave blank in a
# production environment where it is ignored regardless.
OTP_DEV_TEST_CODE=

# --- Payments (Phase 2) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Verifies the webhook signature at /api/webhooks/payments.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Signing secret for /pay/[token] links ----------------------------------
# Must be long and random. Rotating it invalidates all outstanding payment
# links, so keep it stable across deploys.
PAYMENT_TOKEN_SECRET=

# --- Cron -------------------------------------------------------------------
# Bearer token required by every /api/cron/* route. Vercel Cron sends this as
# the Authorization header, so the value must be set in the Vercel project too.
CRON_SECRET=

# --- Observability (optional) ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
